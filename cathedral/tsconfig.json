{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "three": ["./node_modules/@types/three/index.d.ts"],
      "three/addons/*": ["./node_modules/@types/three/examples/jsm/*"]
    },
    "types": ["@iwsdk/vite-plugin-dev/client", "node"]
  },
  "include": ["src/**/*.ts", "../app/plane/{road,plaza,overlook,ground,labels,world,focus}.ts", "../core/**/*.ts", "vite.config.ts"],
  "exclude": ["../core/tests"]
}
