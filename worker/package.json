{
  "name": "trurl-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Cloudflare Worker behind Trurl: auth, rate limits, progress, the Claude reply and the speech-to-text proxy. Holds every provider key; the client never sees one.",
  "scripts": {
    "grounding": "node scripts/copy-grounding.mjs",
    "pretest": "node scripts/copy-grounding.mjs",
    "test": "vitest run",
    "pretypecheck": "node scripts/copy-grounding.mjs",
    "typecheck": "tsc --noEmit",
    "predeploy": "node scripts/copy-grounding.mjs",
    "deploy": "npx wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
