{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truth-mines/schemas/trurl-request.schema.json",
  "title": "Trurl request (client to Worker, POST /api/trurl)",
  "description": "Only facts about where the visitor is and what was said. The client cannot choose the model, the system prompt or the token limit; unknown fields are refused. The Worker also checks that the named places exist in grounding.json and fit together, which a schema cannot say. Mirrors core/schema.ts (TrurlRequest).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plane", "stretch", "moment", "landmark", "looking_at", "earned", "dialogue", "utterance"],
  "properties": {
    "schema_version": { "const": 1 },
    "plane": { "type": ["string", "null"], "minLength": 1 },
    "stretch": { "type": ["string", "null"], "minLength": 1 },
    "moment": { "type": ["string", "null"], "minLength": 1 },
    "landmark": { "type": ["string", "null"], "minLength": 1 },
    "looking_at": { "type": ["string", "null"], "pattern": "^[a-z]{2,12}:[A-Za-z0-9._-]{1,40}$" },
    "earned": { "type": "array", "maxItems": 500, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$" } },
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "text"],
        "properties": {
          "role": { "enum": ["user", "trurl"] },
          "text": { "type": "string" }
        }
      }
    },
    "utterance": { "type": "string", "minLength": 1, "maxLength": 600, "pattern": "\\S" }
  }
}
