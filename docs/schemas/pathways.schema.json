{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truth-mines/schemas/pathways.schema.json",
  "title": "pathways.json",
  "description": "Built by pipeline/pathways.py. Mirrors core/schema.ts (PathwaysFile). entry_requires is derived by the pipeline from graph.json, never written by hand, and pipeline/tests/test_gates.py re-derives it from set.mm itself. Every id is a set.mm label that exists in graph.json (checked by the build and by core/tests/data.test.ts). Rubrics are not here: they are Trurl's private judging notes, in grounding.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pathways"],
  "properties": {
    "schema_version": { "const": 3 },
    "pathways": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plane", "gated_on", "entry_requires", "stretches"],
        "properties": {
          "plane": { "type": "string" },
          "gated_on": { "type": ["string", "null"], "minLength": 1, "description": "The idea the gate was derived from; null when no true gate exists yet" },
          "entry_requires": { "type": ["array", "null"], "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "description": "Derived: the ideas on the map that gated_on truly rests on. null: no gate, the door is sealed" },
          "stretches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "plane_data", "landmarks", "moments"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "plane_data": { "type": "string", "pattern": "^[a-z0-9-]+\\.json$" },
                "landmarks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "moments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "kind", "earns", "question", "question_reviewed"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "kind": { "enum": ["road", "sieve", "overlook"] },
                      "earns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                      "question": { "type": "string", "minLength": 1, "description": "What Trurl asks once the visitor has done the activity. Never the answer." },
                      "question_reviewed": { "type": "boolean", "description": "false until a person approves the wording" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
